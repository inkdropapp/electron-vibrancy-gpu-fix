{
  "name": "@inkdropapp/electron-vibrancy-gpu-fix",
  "version": "0.1.0",
  "description": "Reduce WindowServer GPU load of transparent Electron windows with vibrancy on macOS",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
